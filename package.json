{
  "name": "enough",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "pnpm --filter @enough/web dev",
    "dev:api": "pnpm --filter @enough/api dev",
    "dev:worker": "pnpm --filter @enough/worker dev",
    "extension:build": "pnpm --filter @enough/extension build",
    "test:extension": "vitest run apps/extension/src/background.test.ts",
    "test:extension:integration": "node scripts/phase2-runtime.mjs test --phase10",
    "test:extension:prepare": "node scripts/phase2-runtime.mjs prepare --phase10",
    "test:extension:serve": "node scripts/phase2-runtime.mjs serve --phase10",
    "test:extension:revoke": "node scripts/phase10-revoke-session.mjs",
    "test:desktop:prepare": "node scripts/phase2-runtime.mjs prepare --phase11",
    "test:desktop:serve": "node scripts/phase2-runtime.mjs serve --phase11",
    "test:desktop:revoke": "node scripts/phase11-revoke-session.mjs",
    "test:desktop:clean": "node scripts/phase11-clean.mjs",
    "extension:release:artifacts": "pnpm --filter @enough/extension build && pnpm --filter @enough/extension package:stores",
    "desktop:start": "pnpm --filter @enough/desktop start",
    "desktop:build": "pnpm --filter @enough/desktop build",
    "desktop:dist": "pnpm --filter @enough/desktop dist",
    "db:precheck": "pnpm --filter @enough/db db:precheck",
    "db:migrate": "pnpm --filter @enough/db db:migrate",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "test:auth:integration": "node scripts/phase2-runtime.mjs test",
    "test:auth:serve": "node scripts/phase2-runtime.mjs serve",
    "test:onboarding:integration": "node scripts/phase2-runtime.mjs test --phase3",
    "test:onboarding:serve": "node scripts/phase2-runtime.mjs serve --phase3",
    "test:products:integration": "node scripts/phase2-runtime.mjs test --phase4",
    "test:products:serve": "node scripts/phase2-runtime.mjs serve --phase4",
    "test:activity:integration": "node scripts/phase2-runtime.mjs test --phase5",
    "test:classification:integration": "node scripts/phase2-runtime.mjs test --phase6",
    "test:classification:serve": "node scripts/phase2-runtime.mjs serve --phase6",
    "test:rules:integration": "node scripts/phase2-runtime.mjs test --phase7",
    "test:rules:serve": "node scripts/phase2-runtime.mjs serve --phase7",
    "test:credits:integration": "node scripts/phase2-runtime.mjs test --phase8",
    "test:credits:serve": "node scripts/phase2-runtime.mjs serve --phase8",
    "test:web:integration": "node scripts/phase2-runtime.mjs test --phase9",
    "test:web:serve": "node scripts/phase2-runtime.mjs serve --phase9",
    "test:tasks:integration": "node scripts/phase2-runtime.mjs test --phase12",
    "test:tasks:prepare": "node scripts/phase2-runtime.mjs prepare --phase12",
    "test:tasks:serve": "node scripts/phase2-runtime.mjs serve --phase12",
    "test:tasks:clean": "node scripts/phase12-clean.mjs",
    "test:evidence:integration": "node scripts/phase2-runtime.mjs test --phase13",
    "test:evidence:prepare": "node scripts/phase2-runtime.mjs prepare --phase13",
    "test:evidence:serve": "node scripts/phase2-runtime.mjs serve --phase13",
    "test:evidence:clean": "node scripts/phase13-clean.mjs",
    "test:integrations:integration": "node scripts/phase2-runtime.mjs test --phase14",
    "test:integrations:serve": "node scripts/phase2-runtime.mjs serve --phase14",
    "test:integrations:clean": "node scripts/phase14-clean.mjs",
    "phase14:plausible:acceptance": "node scripts/phase14-plausible-acceptance.mjs",
    "phase14:plausible:verify-revocation": "node scripts/phase14-plausible-acceptance.mjs --verify-provider-revocation",
    "phase14:ga4:acceptance": "node scripts/phase14-ga4-acceptance.mjs",
    "db:migrate:evidence-storage": "node --env-file-if-exists=.env scripts/phase13-evidence-storage-upgrade.mjs",
    "db:phase5:migration-check": "node scripts/phase5-migration-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
