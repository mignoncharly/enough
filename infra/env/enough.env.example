# Template only: PRODUCTION NO-GO. See infra/README.md for classifications and gates.
# Install as /home/enough/apps/enough/shared/.env; chmod 0600 and owner enough.
# Required non-secret configuration (ports/log/session have the defaults shown).
NODE_ENV=production
# Required production secrets: protected connection strings; never use example passwords.
DATABASE_URL=postgresql://enough:URL_ENCODED_PASSWORD@127.0.0.1:5432/enough
REDIS_URL=redis://enough:HEX_PASSWORD@127.0.0.1:6379/0
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
LOG_LEVEL=info
APP_BASE_URL=https://enough.example.com
API_BASE_URL=https://api.enough.example.com
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Required production secret: operator-custodied Ed25519 PKCS#8 PEM.
# Single-line PEM with literal \n separators, enclosed in single quotes; no real key here.
POLICY_SNAPSHOT_SIGNING_PRIVATE_KEY=
AUTH_SESSION_DAYS=30
AUTH_DEV_SHOW_EMAIL_LINKS=false
CREDITS_MANUAL_CONTROLS_ENABLED=false
AUTH_ALLOWED_ORIGINS=
ADMIN_EMAILS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional provider configuration: client IDs are non-secret; client secrets are secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
MICROSOFT_INTEGRATION_CLIENT_ID=
MICROSOFT_INTEGRATION_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRETS=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_TRIAL_DAYS=0
BILLING_GRACE_DAYS=3
STRIPE_AUTOMATIC_TAX=true

# Optional provider configuration at startup; required together for evidence file operations.
# Bucket/region/endpoint are non-secret. Both access credential fields are protected.
# Empty endpoint selects AWS S3 by region; an explicit endpoint selects S3-compatible storage.
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_REGION=
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=

# Required for the daily encrypted off-host backup timer.
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
BACKUP_RCLONE_DEST=offsite:enough-production
BACKUP_RETENTION_DAYS=14
