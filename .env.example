NODE_ENV=development
DATABASE_URL=postgresql://enough:enough@127.0.0.1:5432/enough
REDIS_URL=redis://127.0.0.1:6379/0
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
LOG_LEVEL=info
APP_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:4000
AUTH_SECRET=
AUTH_SESSION_DAYS=30
AUTH_DEV_SHOW_EMAIL_LINKS=true
# Add the exact installed browser extension origin here, such as chrome-extension://<extension-id>.
AUTH_ALLOWED_ORIGINS=
# Comma-separated verified account emails that bootstrap ADMIN access.
ADMIN_EMAILS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
STRIPE_SECRET_KEY=
# Accept multiple comma-separated signing secrets during Stripe endpoint secret rotation.
STRIPE_WEBHOOK_SECRETS=
# Create recurring Stripe Prices after validating pricing. Their intervals must be month and year.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Keep trial length at 0 until a trial offer is validated.
STRIPE_TRIAL_DAYS=0
BILLING_GRACE_DAYS=3
STRIPE_AUTOMATIC_TAX=true
