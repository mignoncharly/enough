{
  "manifest_version": 3,
  "name": "Enough",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Apply your Enough development focus rules in the browser.",
  "permissions": ["alarms", "declarativeNetRequest", "nativeMessaging", "storage", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Enough",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
